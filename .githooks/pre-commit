#!/usr/bin/env bash
# fast gate on every commit: style of the staged files, then clippy and the
# host tests when rust changed. gates live in scripts/check.sh (which enters
# the nix shell itself); pre-push runs the slow ones.

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

mapfile -t staged < <(git diff --cached --name-only --diff-filter=ACMR)
[ ${#staged[@]} -eq 0 ] && exit 0

# build output never belongs in a commit: refuse anything under a directory
# named like a cargo target dir (target, rv-target, ...) and any large file.
bad=0
for f in "${staged[@]}"; do
    if [[ "/$f" =~ /[^/]*target/ ]]; then
        echo "pre-commit: $f is under a build directory" >&2
        bad=1
    elif [ "$(git cat-file -s ":$f")" -gt $((512 * 1024)) ]; then
        echo "pre-commit: $f is over 512 KiB" >&2
        bad=1
    fi
done
[ "$bad" -eq 0 ] || exit 1

scripts/check.sh style "${staged[@]}"
if printf '%s\n' "${staged[@]}" | grep -qE '\.(rs|toml|s)$'; then
    scripts/check.sh clippy
    scripts/check.sh test
fi
